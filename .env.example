# Supabase (Project Settings > API). The service role key is only used server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LLM used to draft the briefs. Set ONE of the two keys.
# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Anthropic (paid)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: force "groq" or "anthropic" when both keys are set
LLM_PROVIDER=

# Optional: if set, POST endpoints (ingest, generate) require header x-admin-token
ADMIN_TOKEN=

# Optional: used by the Vercel cron to call /api/ingest
CRON_SECRET=

# Optional: AMF_USE_FIXTURE=1 replays fixtures/sample-records.json instead of calling the API
AMF_USE_FIXTURE=
